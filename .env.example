# ---- dashboard
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=change-me
# Encrypts stored account credentials. Set a long random string and never lose it
# (empty = auto-generated into data/secret.key).
APP_SECRET_KEY=
APP_TIMEZONE=Asia/Tehran
APP_DRY_RUN=true

# ---- scheduler
APP_TICK_SECONDS=60
APP_MAX_JOBS_PER_TICK=5
APP_ACCOUNT_MAX_FAILURES=3

# ---- AI: your Ollama server (outside Arvan). Test with:  docker compose exec nexa python -m app.cli llm-test
APP_LLM_PROVIDER=ollama
APP_LLM_BASE_URL=http://YOUR-OLLAMA-SERVER-IP:11434
# only if the Ollama server sits behind a proxy that checks "Authorization: Bearer <key>"
APP_LLM_API_KEY=
# a model that is already pulled on that server (see: ollama list)
APP_LLM_MODEL=qwen2.5:14b
# Other options:
#   any OpenAI-compatible API:  APP_LLM_PROVIDER=openai  APP_LLM_BASE_URL=https://.../v1  APP_LLM_API_KEY=...
#   Claude:                     APP_LLM_PROVIDER=anthropic  APP_ANTHROPIC_API_KEY=sk-ant-...
