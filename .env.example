# ---- dashboard
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=change-me
# Encrypts stored account credentials. Set a long random string and never lose it
# (empty = auto-generated into data/secret.key).
APP_SECRET_KEY=
APP_TIMEZONE=Asia/Tehran
APP_DRY_RUN=true

# ---- scheduler
APP_TICK_SECONDS=60
APP_MAX_JOBS_PER_TICK=5
APP_ACCOUNT_MAX_FAILURES=3

# ---- LLM: "openai" (Ollama / vLLM / OpenRouter / any OpenAI-compatible), "anthropic", or "fake"
APP_LLM_PROVIDER=openai
APP_LLM_BASE_URL=http://host.docker.internal:11434/v1
APP_LLM_API_KEY=ollama
APP_LLM_MODEL=qwen2.5:14b
# APP_LLM_PROVIDER=anthropic
# APP_ANTHROPIC_API_KEY=sk-ant-...
# APP_ANTHROPIC_MODEL=claude-opus-5-5
